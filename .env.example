# ==========================================
# Environment Variables Blueprint (SIH 2026 PS 26092)
# ==========================================

# Backend Configuration
PROJECT_NAME="AI-Driven Scheme Matcher"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:19006"]

# Database (PostgreSQL with pgvector / Supabase)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/scheme_matcher"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scheme_matcher"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# Authentication (Supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# LLM / AI Layer (Claude / Gemini API)
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Geo & Maps
GOOGLE_MAPS_API_KEY=""

# Notifications (FCM / SMS Gateway)
FIREBASE_CREDENTIALS_PATH=""
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID="NSFDC"
